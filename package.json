{
  "name": "herdr-companion",
  "displayName": "Herdr for VS Code",
  "description": "Herdr AI coding agents in VS Code: live status, fast switcher, and focus-on-blocked.",
  "version": "0.4.5",
  "publisher": "xicu",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://herdr.dev",
  "bugs": {
    "url": "https://github.com/XicuM/herdr-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XicuM/herdr-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "herdr",
    "ai",
    "agents",
    "claude",
    "codex",
    "opencode",
    "terminal"
  ],
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "herdr.switchConversation",
        "title": "Herdr: Switch Agent Conversation",
        "icon": "$(beaker)"
      },
      {
        "command": "herdr.switchNext",
        "title": "Herdr: Next Agent Conversation",
        "icon": "$(arrow-right)"
      },
      {
        "command": "herdr.switchPrev",
        "title": "Herdr: Previous Agent Conversation",
        "icon": "$(arrow-left)"
      },
      {
        "command": "herdr.newConversation",
        "title": "Herdr: New Agent Conversation",
        "icon": "$(plus)"
      },
      {
        "command": "herdr.openConversation",
        "title": "Herdr: Open Conversation"
      },
      {
        "command": "herdr.closeConversation",
        "title": "Herdr: Close Conversation",
        "icon": "$(trash)"
      },
      {
        "command": "herdr.renameConversation",
        "title": "Herdr: Rename Tab",
        "icon": "$(edit)"
      },
      {
        "command": "herdr.sendSelection",
        "title": "Herdr: Send Selection to Agent",
        "icon": "$(send)"
      },
      {
        "command": "herdr.installAgentSkill",
        "title": "Herdr: Install Agent Skill (Open Files in VS Code)"
      },
      {
        "command": "herdr.openMasterTerminal",
        "title": "Herdr: Open Herdr Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.focusWorkspace",
        "title": "Herdr: Focus Workspace",
        "icon": "$(home)"
      },
      {
        "command": "herdr.newShellTab",
        "title": "Herdr: New Shell Tab",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.refresh",
        "title": "Herdr: Refresh Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.diagnose",
        "title": "Herdr: Diagnose Connection"
      }
    ],
    "keybindings": [
      {
        "command": "herdr.switchNext",
        "key": "ctrl+tab",
        "when": "focusedView == herdr.tabs"
      },
      {
        "command": "herdr.switchPrev",
        "key": "ctrl+shift+tab",
        "when": "focusedView == herdr.tabs"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "herdr.sendSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@100"
        }
      ],
      "webview/context": [
        {
          "command": "herdr.renameConversation",
          "when": "webviewId == 'herdr.tabs' && webviewSection == 'tab'",
          "group": "1_edit@1"
        },
        {
          "command": "herdr.sendSelection",
          "when": "webviewId == 'herdr.tabs' && webviewSection == 'tab' && isAgent",
          "group": "1_edit@2"
        },
        {
          "command": "herdr.closeConversation",
          "when": "webviewId == 'herdr.tabs' && webviewSection == 'tab'",
          "group": "2_close@1"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "herdrTabs",
          "title": "Herdr",
          "icon": "media/herdr.svg"
        }
      ]
    },
    "views": {
      "herdrTabs": [
        {
          "id": "herdr.tabs",
          "name": "Agents",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Herdr",
      "properties": {
        "herdr.focusOnBlocked": {
          "type": "boolean",
          "default": true,
          "description": "When an agent transitions into blocked (waiting for input), show it and notify. The terminal is revealed without stealing editor focus."
        },
        "herdr.session": {
          "type": "string",
          "default": "vscode",
          "description": "Named herdr session used by VS Code. The default keeps this window separate from the desktop session and other clients."
        },
        "herdr.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start `herdr server` for this session when the extension activates and no socket exists. Off: the extension only reads state and reports herdr as offline."
        },
        "herdr.defaultHarness": {
          "type": "string",
          "enum": [
            "agy",
            "amp",
            "claude",
            "codex",
            "copilot",
            "cursor",
            "devin",
            "gemini",
            "grok",
            "kimi",
            "kiro",
            "maki",
            "opencode",
            "pi",
            "qwen"
          ],
          "default": "claude",
          "description": "Harness listed first in the New Agent Conversation picker."
        }
      }
    }
  },
  "scripts": {
    "compile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "publish": "npx --yes @vscode/vsce publish --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "build": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
